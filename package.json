{
  "$schema": "https://raw.githubusercontent.com/vicinaehq/vicinae/refs/heads/main/extra/schemas/extension.json",
  "name": "dns-manager",
  "title": "DNS Manager",
  "description": "View the active DNS server and its latency, and switch to common DNS presets",
  "icon": "icon.png",
  "author": "brpaz",
  "license": "MIT",
  "commands": [
    {
      "icon": "icon.png",
      "name": "list",
      "subtitle": "DNS Manager",
      "title": "Manage DNS",
      "description": "View the active DNS server and switch to a preset",
      "mode": "view"
    }
  ],
  "preferences": [],
  "categories": [
    "System"
  ],
  "dependencies": {
    "@vicinae/api": "^0.28.0",
    "execa": "^10.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@types/react": "19.2.18",
    "typescript": "5.9.3"
  },
  "scripts": {
    "build": "vici build",
    "dev": "vici develop",
    "lint": "biome check src/ && vici lint",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "typecheck": "tsc --noEmit",
    "check": "biome check --write ."
  }
}
